# Optional host-managed OpenAI-compatible endpoint. No provider key needed for demo.
# WOLF_MODEL_BASE_URL=http://127.0.0.1:8000/v1
# WOLF_MODEL_NAME=your-served-model
# WOLF_MODEL_TOKEN=host-managed-only-if-required

# Track 1 evidence engine (all optional)
# Extra hosts the evidence API answers for, comma-separated host[:port]. Localhost is always allowed.
# WOLF_ALLOWED_HOSTS=wolf-demo.example.com
# Allow POST /api/evidence/reset/ in a production build (it is always available in `npm run dev`).
# WOLF_DEMO_RESET=1
# Dataset location; defaults to ../kit/dataset relative to frontend/.
# WOLF_KIT_DIR=/absolute/path/to/kit/dataset
